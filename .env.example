# =============================================================================
# ct-core-api — Backend de Ingesta (NestJS + MongoDB + AWS)
# =============================================================================
CT_CORE_API_PORT=3000
MONGODB_URI=mongodb://localhost:27017/compra-transparente

# ChileCompra API
CHILECOMPRA_TICKET=your_ticket_here
CHILECOMPRA_API_URL=https://api.mercadopublico.cl/servicios/v1

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/YOUR_ACCOUNT/ct-licitaciones.fifo
SQS_DLQ_URL=https://sqs.us-east-1.amazonaws.com/YOUR_ACCOUNT/ct-licitaciones-dlq.fifo
S3_BUCKET_PAYLOADS=ct-payloads
SES_FROM_EMAIL=alertas@parapymes.cl

# Misc
CORS_ORIGINS=http://localhost:3001
PINO_LOG_LEVEL=debug
THROTTLE_LIMIT=100

# =============================================================================
# ct-core-web — Dashboard Frontend (Next.js 16)
# =============================================================================
CT_CORE_WEB_PORT=3001

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# API interna
CT_CORE_API_URL=http://localhost:3000

# =============================================================================
# ct-fondos — Agregador de Fondos (NestJS + PostgreSQL)
# =============================================================================
CT_FONDOS_PORT=3002
DATABASE_URL=postgresql://ct_fondos:password@localhost:5432/ct_fondos

# Redis
REDIS_URL=redis://localhost:6379

# Notificaciones
RESEND_API_KEY=re_your_key_here
RESEND_FROM_EMAIL=fondos@parapymes.cl

# WhatsApp (fase 2)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# =============================================================================
# ct-analytics — Servicio ML/BI (FastAPI + Python)
# =============================================================================
CT_ANALYTICS_PORT=8000

# Lectura de datos del core
MONGODB_URI_ANALYTICS=mongodb://localhost:27017/compra-transparente

# Supabase pgvector
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# OpenAI (RAG)
OPENAI_API_KEY=sk-your_key_here

# Modal.com (inferencia ML)
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
